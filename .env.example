# PostgreSQL container
POSTGRES_DB=connectsphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Auth service database
DB_URL=jdbc:postgresql://localhost:5434/connectsphere
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT
# Use a long random secret in your local environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Test profile
TEST_DB_URL=jdbc:postgresql://localhost:5432/connectsphere_auth_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=change-me
